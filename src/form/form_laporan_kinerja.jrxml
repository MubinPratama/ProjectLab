	<queryString language="SQL">
		<![CDATA[SELECT
     laporan_kinerja.`id_laporan` AS laporan_kinerja_id_laporan,
     laporan_kinerja.`id_dokter` AS laporan_kinerja_id_dokter,
     laporan_kinerja.`periode_awal` AS laporan_kinerja_periode_awal,
     laporan_kinerja.`periode_akhir` AS laporan_kinerja_periode_akhir,
     laporan_kinerja.`jumlah_pasien` AS laporan_kinerja_jumlah_pasien,
     laporan_kinerja.`nilai_kinerja` AS laporan_kinerja_nilai_kinerja,
     laporan_kinerja.`catatan` AS laporan_kinerja_catatan
FROM
     `laporan_kinerja` laporan_kinerja]]>
	</queryString>
