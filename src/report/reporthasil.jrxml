	<queryString language="SQL">
		<![CDATA[SELECT
     hasil_periksa.`id` AS hasil_periksa_id,
     hasil_periksa.`id_pendaftaran` AS hasil_periksa_id_pendaftaran,
     hasil_periksa.`nama_pemeriksaan` AS hasil_periksa_nama_pemeriksaan,
     hasil_periksa.`hasil_pemeriksaan` AS hasil_periksa_hasil_pemeriksaan,
     hasil_periksa.`waktu_input` AS hasil_periksa_waktu_input
FROM
     `hasil_periksa` hasil_periksa]]>
	</queryString>
	<field name="hasil_periksa_id" class="java.lang.Integer"/>
