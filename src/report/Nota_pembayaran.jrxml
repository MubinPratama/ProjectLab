<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="300" pageHeight="842" columnWidth="260" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f41297e-42fc-4dcc-8b9c-fac6a12787e3">
	<property name="ireport.zoom" value="1.771561000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_pembayaran" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    pb.id_pembayaran,
    p.id_pendaftaran,
    ps.Nama AS nama_pasien,
    d.Nama AS nama_dokter,
    p.tanggal_daftar,
    l.nama_layanan,
    pd.harga
FROM 
    pembayaran pb
JOIN pendaftaran p ON pb.id_pendaftaran = p.id_pendaftaran
JOIN pasien ps ON p.No_rm = ps.No_rm
JOIN dokter d ON p.id_dokter = d.id_dokter
JOIN pendaftaran_detail pd ON p.id_pendaftaran = pd.id_pendaftaran
JOIN layanan l ON pd.id_layanan = l.id_layanan
WHERE pb.id_pembayaran = $P{id_pembayaran}]]>
	</queryString>
	<field name="id_pembayaran" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="id_pendaftaran" class="java.lang.Long">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="nama_dokter" class="java.lang.String"/>
	<field name="tanggal_daftar" class="java.sql.Date">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_layanan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="harga" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{harga}]]></variableExpression>
	</variable>
