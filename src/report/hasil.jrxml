	<subDataset name="New Dataset 1" uuid="e9cf3924-8746-4852-86a3-1df1227e061b"/>
	<parameter name="id_pendaftaran" class="java.lang.Long" isForPrompting="false"/>
	<parameter name="layanan" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    ps.nama AS nama_pasien,
    d.nama AS nama_dokter,
    p.tanggal_daftar,
    h.nama_pemeriksaan,
    h.hasil_pemeriksaan
FROM hasil_periksa h
JOIN pendaftaran p ON h.id_pendaftaran = p.id_pendaftaran
JOIN pasien ps ON p.No_rm = ps.No_rm
JOIN dokter d ON p.id_dokter = d.id_dokter
WHERE 
h.id_pendaftaran = $P{id_pendaftaran} and 
h.layanan = $P{layanan}]]>
	</queryString>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="nama_dokter" class="java.lang.String"/>
	<field name="tanggal_daftar" class="java.sql.Date">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_pemeriksaan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="hasil_pemeriksaan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
