	<property name="ireport.zoom" value="1.6105100000000017"/>
	<property name="ireport.x" value="48"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_pendaftaran" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT 
    ps.nama AS nama_pasien,
    d.nama AS nama_dokter,
    p.tanggal_daftar,
    h.nama_pemeriksaan,
    h.hasil_pemeriksaan
FROM hasil_periksa h
JOIN pendaftaran p ON h.id_pendaftaran = p.id_pendaftaran
JOIN pasien ps ON p.No_rm = ps.No_rm
JOIN dokter d ON p.id_dokter = d.id_dokter
WHERE h.id_pendaftaran = $p{id_pendaftaran}]]>
	</queryString>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="nama_dokter" class="java.lang.String"/>
	<field name="tanggal_daftar" class="java.sql.Date">
