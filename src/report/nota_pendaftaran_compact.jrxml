<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="300" pageHeight="842" columnWidth="260" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="5" uuid="85975a13-cbaf-4717-91fe-c9eeb29eecc5">
	<property name="ireport.zoom" value="2.0490403660952174"/>
	<property name="ireport.x" value="4"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_pendaftaran" class="java.lang.String"/>
	<queryString>
		SELECT 
    p.id_pendaftaran, 
    p.tanggal_daftar,
    ps.Nama AS nama_pasien, 
    d.Nama AS nama_dokter,
    l.nama_layanan,
    l.harga
FROM pendaftaran p
JOIN pasien ps ON p.No_rm = ps.No_rm
JOIN dokter d ON p.id_dokter = d.id_dokter
JOIN pendaftaran_detail pd ON p.id_pendaftaran = pd.id_pendaftaran
JOIN layanan l ON pd.id_layanan = l.id_layanan
WHERE p.id_pendaftaran = $P{id_pendaftaran}

	</queryString>
	<field name="id_pendaftaran" class="java.lang.Long">
		<fieldDescription></fieldDescription>
	</field>
	<field name="tanggal_daftar" class="java.sql.Date">
		<fieldDescription></fieldDescription>
	</field>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="nama_dokter" class="java.lang.String"/>
	<field name="nama_layanan" class="java.lang.String">
		<fieldDescription></fieldDescription>
	</field>
	<field name="harga" class="java.math.BigDecimal">
		<fieldDescription></fieldDescription>
	</field>
