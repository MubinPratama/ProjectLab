	<queryString>
		<![CDATA[SELECT
     pembayaran.`id_pembayaran` AS pembayaran_id_pembayaran,
     pembayaran.`id_pendaftaran` AS pembayaran_id_pendaftaran,
     pembayaran.`tanggal_bayar` AS pembayaran_tanggal_bayar,
     pembayaran.`total_bayar` AS pembayaran_total_bayar,
     pembayaran.`metode_pembayaran` AS pembayaran_metode_pembayaran,
     pembayaran.`dibayar` AS pembayaran_dibayar,
     pembayaran.`kembali` AS pembayaran_kembali
FROM
     `pembayaran` pembayaran]]>
	</queryString>
