	<queryString language="SQL">
		<![CDATA[SELECT
     dokter.`Id_Dokter` AS dokter_Id_Dokter,
     dokter.`Nama` AS dokter_Nama,
     pembayaran.`id_pembayaran` AS pembayaran_id_pembayaran,
     pembayaran.`id_pendaftaran` AS pembayaran_id_pendaftaran,
     pembayaran.`tanggal_bayar` AS pembayaran_tanggal_bayar,
     pembayaran.`total_bayar` AS pembayaran_total_bayar,
     pembayaran.`metode_pembayaran` AS pembayaran_metode_pembayaran,
     pembayaran.`dibayar` AS pembayaran_dibayar,
     pembayaran.`kembali` AS pembayaran_kembali,
     pendaftaran.`id_pendaftaran` AS pendaftaran_id_pendaftaran,
     pendaftaran.`No_rm` AS pendaftaran_No_rm,
     pendaftaran.`Id_dokter` AS pendaftaran_Id_dokter,
     pendaftaran.`tanggal_daftar` AS pendaftaran_tanggal_daftar,
     pendaftaran_detail.`id_detail` AS pendaftaran_detail_id_detail,
     pendaftaran_detail.`id_pendaftaran` AS pendaftaran_detail_id_pendaftaran,
     pendaftaran_detail.`id_layanan` AS pendaftaran_detail_id_layanan,
     pendaftaran_detail.`harga` AS pendaftaran_detail_harga,
     pasien.`No_rm` AS pasien_No_rm,
     pasien.`Nama` AS pasien_Nama,
     pasien.`Alamat` AS pasien_Alamat,
     pasien.`jk` AS pasien_jk,
     pasien.`no_telp` AS pasien_no_telp,
     pasien.`Tgl_Lahir` AS pasien_Tgl_Lahir,
     pasien.`Tinggi` AS pasien_Tinggi,
     pasien.`Berat` AS pasien_Berat,
     pasien.`goldar` AS pasien_goldar,
     layanan.`id_layanan` AS layanan_id_layanan,
     layanan.`nama_layanan` AS layanan_nama_layanan,
     layanan.`harga` AS layanan_harga,
     dokter.`Kontak` AS dokter_Kontak
FROM
     `dokter` dokter INNER JOIN `pendaftaran` pendaftaran ON dokter.`Id_Dokter` = pendaftaran.`Id_dokter`
     INNER JOIN `pembayaran` pembayaran ON pendaftaran.`id_pendaftaran` = pembayaran.`id_pendaftaran`
     INNER JOIN `pendaftaran_detail` pendaftaran_detail ON pendaftaran.`id_pendaftaran` = pendaftaran_detail.`id_pendaftaran`
     INNER JOIN `pasien` pasien ON pendaftaran.`No_rm` = pasien.`No_rm`
     INNER JOIN `layanan` layanan ON pendaftaran_detail.`id_layanan` = layanan.`id_layanan`]]>
	</queryString>
