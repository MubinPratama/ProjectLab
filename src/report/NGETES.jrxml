	<subDataset name="Table Dataset 1" uuid="06f38821-c4ed-4d9b-a9f2-20f6ac98df8f"/>
	<parameter name="Dari" class="java.util.Date"/>
	<parameter name="param_iddokter" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    d.id_dokter, 
    d.Nama AS nama_dokter, 
    COUNT(p.id_pendaftaran) AS jumlah_pemeriksaan, 
    MIN(p.tanggal_daftar) AS aktif_mulai
FROM 
    pendaftaran p
JOIN 
    dokter d ON p.id_dokter = d.id_dokter
WHERE 
     d.id_dokter = $P{param_iddokter}
  AND p.tanggal_daftar>=$P{Dari}
GROUP BY 
    d.id_dokter, d.Nama]]>
	</queryString>
	<field name="id_dokter" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_dokter" class="java.lang.String"/>
	<field name="jumlah_pemeriksaan" class="java.lang.Long"/>
	<field name="aktif_mulai" class="java.sql.Date">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
